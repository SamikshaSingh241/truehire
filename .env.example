# TrueHire Environment Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Neon PostgreSQL (or local PostgreSQL)
# Application pooled connection string (e.g. postgresql://user:pass@ep-xyz-pooler.region.neon.tech/dbname?sslmode=require)
DATABASE_URL="YOUR_NEON_POOLED_CONNECTION_STRING"

# Database migration direct connection string (e.g. postgresql://user:pass@ep-xyz.region.neon.tech/dbname?sslmode=require)
DIRECT_URL="YOUR_NEON_DIRECT_CONNECTION_STRING"

# JWT Authentication
JWT_SECRET=replace-with-a-secure-random-secret-key-min-32-chars
JWT_EXPIRES_IN=7d

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# SMTP Email (Gmail / SendGrid / etc.)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=replace-with-email-app-password

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me
